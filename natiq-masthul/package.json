{
  "name": "natiq-masthul",
  "version": "2.0.0",
  "description": "Advanced TetraShop project with deep learning optimization",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.js",
    "format": "prettier --write src/**/*.js",
    "build": "npm run lint && npm test",
